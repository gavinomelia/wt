#!/bin/sh
# Links this checkout's wt into ~/.local/bin, outside any Node version manager's folders,
# so a project that pins another Node version still finds it.
set -e
root=$(cd "$(dirname "$0")/.." && pwd -P)
mkdir -p "$HOME/.local/bin"
ln -sf "$root/bin/wt" "$HOME/.local/bin/wt"
echo "Installed: $HOME/.local/bin/wt -> $root/bin/wt"

case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*)
	echo "Add this to your shell profile, then open a new terminal:"
	# The line is printed for the user to paste, so $HOME and $PATH stay unexpanded.
	# shellcheck disable=SC2016
	echo '  export PATH="$HOME/.local/bin:$PATH"'
	;;
esac
