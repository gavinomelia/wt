#!/usr/bin/env bash
# WT_ON_REMOVE script for Herdr.app: closes every space open on the worktree before wt removes it.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
herdr_running || exit 0
for space in $(spaces_in_folder "$WT_PATH"); do
  herdr-app do space.close --id "$space" --confirmed true >/dev/null
done
