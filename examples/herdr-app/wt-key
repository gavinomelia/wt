#!/usr/bin/env bash
# wt key <command> [args]: runs `wt <command>` from a Herdr key binding. Herdr keys run a command in a
# new tab, which would otherwise linger as a shell, so this closes the tab afterwards. Listings and
# errors stay up until a key is pressed.
set -uo pipefail
. "$(dirname "$0")/lib.sh"
tab=$(tab_of_terminal "${HC_TERMINAL_ID:-}")
wt "$@"
status=$?
case "$1:$status" in
  ls:* | prune:* | *:[1-9]*) read -rsn1 -p "press any key" </dev/tty || true ;;
esac
[ -z "$tab" ] || herdr-app do tab.close --id "$tab" --confirmed true >/dev/null
