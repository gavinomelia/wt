#!/usr/bin/env bash
# wt on-remove hook for herdr: closes the worktree's workspace before wt removes the checkout.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
workspace=$(workspace_for_path "$WT_PATH")
[ -n "$workspace" ] || exit 0
# Closing the workspace kills the panes in it, including the one running wt
[ "$workspace" != "${HERDR_WORKSPACE_ID:-}" ] || die "run wt rm from another workspace, such as the main checkout's"
herdr workspace close "$workspace" >/dev/null
