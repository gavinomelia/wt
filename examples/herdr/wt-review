#!/usr/bin/env bash
# wt review [base]: splits the focused pane and starts Codex reviewing this branch against base
# (default WT_BASE), read-only
set -euo pipefail
. "$(dirname "$0")/lib.sh"
base=${1:-${WT_BASE:-main}}
root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git checkout"
pane=$(herdr pane split "${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:?run wt review inside herdr}}" --direction right --ratio 0.5 --cwd "$root" |
  jq -r '.result.pane.pane_id')
branch=$(branch_name "$root")
start_agent "review-${branch:-$(basename "$root")}" codex "$pane" --approve-for-me "${REVIEW_PROMPT//%s/$base}"
