# wt settings for a Rails app on PostgreSQL. Copy to ~/.config/wt/projects/<repo folder name>.env,
# and these hooks to ~/.config/wt/rails-postgres/ (or point the paths below wherever you put them).
R=$HOME/.config/wt/rails-postgres

WT_ON_SETUP=$R/setup
WT_SERVE=$R/serve
WT_ON_GC=$R/gc
WT_COMMANDS=$HOME/.config/wt/commands:$R   # adds `wt snapshot`

# Database names start with this. The main checkout must use <prefix>_development and <prefix>_test;
# each worktree gets <prefix>_<branch> and <prefix>_test_<branch>.
WT_DB_PREFIX=my_app
# WT_SNAPSHOT_DB=my_app_wt_snapshot

# The portless name: the main checkout serves at https://my-app.localhost, a worktree at
# https://<branch>.my-app.localhost. Leave WT_APP and WT_URL out if you don't use portless.
WT_APP=my-app
WT_URL='portless get "$WT_APP"'

# What `wt serve` runs with foreman; relative to the checkout, or an absolute path
WT_PROCFILE=$R/Procfile

# Every worktree's browser signs in as this user (see worktree_auto_login.rb). Leave empty to sign in by hand.
WT_AUTO_LOGIN_EMAIL=
